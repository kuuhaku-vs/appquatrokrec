# Copie este arquivo para ".env" e preencha.
# O login (usuario e senha do Protheus) e feito na tela do site.

# Endereco da genericQuery do Protheus, por exemplo:
# PROTHEUS_URL=https://SEU-SERVIDOR:PORTA/rest/api/framework/v1/genericQuery
PROTHEUS_URL=

# 1 = aceita o certificado interno do Protheus (igual a desligar a verificacao SSL no Postman)
PROTHEUS_IGNORE_SSL=1

# Porta do site (http://localhost:3000)
PORT=3000

# Horas sem uso ate a sessao encerrar e pedir login de novo
HORAS_SESSAO=10

# Campos da SZ5 (so mude se o dicionario mudar)
CAMPO_PRODUTO=Z5_PROD
CAMPO_QUANTIDADE=Z5_PESOATU
