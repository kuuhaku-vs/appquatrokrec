# Copie este arquivo para ".env" e preencha.

# Login do Protheus (o mesmo usado no Postman)
PROTHEUS_USER=
PROTHEUS_PASS=

# Endereço da genericQuery
PROTHEUS_URL=https://protheus.quatroktextil.com.br:6632/rest05/api/framework/v1/genericQuery

# 1 = aceita o certificado interno do Protheus (igual a desligar a verificação SSL no Postman)
PROTHEUS_IGNORE_SSL=1

# Porta do site (http://localhost:3000)
PORT=3000

# Campos da SZ5 (só mude se o dicionário mudar)
CAMPO_PRODUTO=Z5_PROD
CAMPO_QUANTIDADE=Z5_PESOATU
